# Envio do formulário de contato via SMTP do Google Workspace.
# Copie para .env.local (já ignorado pelo git) e preencha. Na Vercel, cadastre
# as mesmas chaves em Project Settings → Environment Variables.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Conta do Workspace que autentica o envio.
SMTP_USER=contato@diggia.com.br

# Senha de app de 16 dígitos (NÃO a senha normal da conta).
# Requer verificação em duas etapas ativa na conta. Gere em:
# https://myaccount.google.com/apppasswords
SMTP_PASS=

# Opcionais — o padrão de ambos é SMTP_USER.
# CONTACT_TO   = para onde os leads chegam
# CONTACT_FROM = remetente; PRECISA ser um e-mail do domínio diggia.com.br
CONTACT_TO=contato@diggia.com.br
CONTACT_FROM=contato@diggia.com.br
